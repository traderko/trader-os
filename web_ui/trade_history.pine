compactMode   = input.bool(true,  "Compact Mode (점/네모 + 마우스오버 툴팁)", group="Display")
mobileMode    = input.bool(false, "모바일 모드 (청산 라벨에 손익 항상 표시)", group="Display")
showPctLabel  = input.bool(false, "청산 라벨에 손익 % 표시", group="Display", tooltip="청산 직전 잔고 대비 손익 %. 잔고 기록이 있는 거래만")
showTimeLabel = input.bool(false, "라벨에 시간 표시", group="Display")
timeFormat    = input.string("MM-dd HH:mm", "시간 표시 형식", group="Display")
labelTz       = input.string("Asia/Seoul", "라벨 시간대", group="Display")
showLines     = input.bool(true,  "Show Entry-Exit Lines",  group="Display")
showEntry     = input.bool(true,  "Show Entry Markers",     group="Display", tooltip="끄면 거래당 라벨이 1개라 한 화면에 더 많이 그림")
showSLTP      = input.bool(true,  "SL/TP 점선 표시",        group="Display", tooltip="청산 직전에 걸려 있던 SL(빨강)·TP(초록)를 진입~청산 구간에 점선으로. 기록이 있는 거래만 (11월 10일 업데이트 이후)")
showStats     = input.bool(false, "Show Stats Table",       group="Display")
statsScope    = input.string("화면", "통계·집계 기준", options=["화면", "전체"], group="Display")
labelSizeOpt  = input.string("tiny", "Label Size", options=["tiny", "small", "normal", "large"], group="Display")
lineWidth     = input.int(1, "Line Width", minval=1, maxval=5, group="Display")
lineStyleOpt  = input.string("Arrow", "Line Style", options=["Arrow", "Solid", "Dashed", "Dotted"], group="Display")
offsetPct     = input.float(0.1, "Label Offset (%)", minval=0, maxval=3, step=0.05, group="Display")

entryColor = input.color(color.new(color.gray, 0), "Entry Marker Color", group="Colors")
winColor   = input.color(color.new(color.teal, 0), "Exit Win Color",     group="Colors")
lossColor  = input.color(color.new(color.red,  0), "Exit Loss Color",    group="Colors")

showAggTable = input.bool(true, "기간별 집계 표 표시", group="Summary Table")
aggPeriod    = input.string("Daily", "집계 단위", options=["Daily", "Weekly"], group="Summary Table")
maxAggRows   = input.int(10, "최대 표시 행수 (최근 N개)", minval=3, maxval=60, group="Summary Table")
aggTablePos  = input.string("Bottom Right", "집계표 위치", options=["Bottom Right", "Bottom Left", "Bottom Center"], group="Summary Table")
aggTz        = input.string("Asia/Seoul", "집계 기준 시간대", group="Summary Table")

// 스크린샷용: 마우스를 올리지 않아도 보이게 - 청산 라벨에 번호(#1, #2 …), 구석 표에 그 번호의 자세한 내용
infoOn     = input.bool(false, "거래 정보 표 (스크린샷용)", group="거래 정보 표",
     tooltip="화면에 보이는 최근 거래 몇 개를 구석 표로. 화면 안 모든 청산 라벨에 #번호(왼쪽부터 #1)가 붙어 표와 맞춰 볼 수 있음. 캔들을 가리지 않게 위치를 고르세요")
infoCount  = input.int(5, "표시할 거래 수 (화면 안 최근)", minval=1, maxval=20, group="거래 정보 표")
infoSel    = input.string("", "고른 번호만 (예: 3 · 2,5 · 2-4)", group="거래 정보 표",
     tooltip="비워 두면 표에 최근 N개. 라벨 · 툴팁의 #번호를 넣으면 그 거래만 표에 나옴 (여러 개: 쉼표 · 범위). 차트를 옮기면 번호가 다시 매겨짐")
infoOnly   = input.bool(false, "고른 거래만 그리기", group="거래 정보 표", tooltip="고른 번호가 있을 때 나머지 거래는 차트에서 숨김 (번호는 그대로)")
infoPos    = input.string("Bottom Left", "표 위치", options=["Top Left", "Top Center", "Top Right", "Bottom Left", "Bottom Center", "Bottom Right", "Middle Left", "Middle Right"], group="거래 정보 표")
infoSize   = input.string("small", "글자 크기", options=["tiny", "small", "normal", "large"], group="거래 정보 표")
infoRun    = input.bool(true, "최대 평가이익 · 손실 칸", group="거래 정보 표")
infoMargin = input.bool(true, "증거금율 칸", group="거래 정보 표")
infoSLTP   = input.bool(false, "SL · TP 칸", group="거래 정보 표")
infoBg     = input.int(70, "표 배경 투명도", minval=0, maxval=100, group="거래 정보 표")
grpInfo    = input.bool(true, "개별 거래 보기에서도 묶음 정보 표시", group="거래 정보 표",
     tooltip="보기 방식이 '개별 거래'일 때, 분할 진입 묶음에 속한 거래면 툴팁에 묶음 전체 손익 · 최대 이익 · 손실을 덧붙이고 거래 정보 표에 묶음 칸을 추가")

// ============================================================
// 전역
// ============================================================
TF_MS     = timeframe.in_seconds(timeframe.period) * 1000
MAX_LINES  = 500         // 파인 그림 한도 (선)
MAX_LABELS = 500         // 파인 그림 한도 (라벨)
// 묶음 데이터(DATA_MERGED)면 한 줄이 이미 묶음 - 다시 묶지 않음
useGroups  = not DATA_MERGED and viewMode != "개별 거래"
showPicks  = not DATA_MERGED and viewMode == "묶음 + 개별 진입점"

f_labelSize() =>
    switch labelSizeOpt
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.tiny

f_lineStyle() =>
    switch lineStyleOpt
        "Arrow"  => line.style_arrow_right
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_arrow_right

f_aggTablePos() =>
    switch aggTablePos
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_infoPos() =>
    switch infoPos
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        "Middle Left"   => position.middle_left
        "Middle Right"  => position.middle_right
        => position.bottom_left

// "2,5,7-9" → [2, 5, 7, 8, 9]
f_selSet(string src) =>
    out = array.new<int>()
    for tok in str.split(str.replace_all(src, " ", ""), ",")
        if str.length(tok) > 0
            ab = str.split(tok, "-")
            a  = str.tonumber(array.get(ab, 0))
            b  = array.size(ab) > 1 ? str.tonumber(array.get(ab, 1)) : a
            if not na(a) and not na(b) and b >= a and b - a < 500
                for k = int(a) to int(b)
                    array.push(out, k)
    out

f_infoSize() =>
    switch infoSize
        "tiny"   => size.tiny
        "normal" => size.normal
        "large"  => size.large
        => size.small

f_snapToBar(ms) =>
    int(math.floor(ms / TF_MS) * TF_MS)

f_periodKey(closeMs) =>
    if aggPeriod == "Weekly"
        dow      = dayofweek(closeMs, aggTz)
        daysBack = dow == dayofweek.sunday ? 6 : dow - dayofweek.monday
        str.format_time(closeMs - daysBack * 86400000, "yyyy-MM-dd", aggTz)
    else
        str.format_time(closeMs, "yyyy-MM-dd", aggTz)

// 심볼 이름 정리: 대문자 + 브로커 꼬리표 떼기 (NAS100+ → NAS100, XAUUSD.r → XAUUSD, BTCUSD-m → BTCUSD)
f_clean(string s) =>
    u = str.upper(s)
    for c in array.from("+", ".", "-", "_", "#", "!", ":")
        p = str.pos(u, c)
        if not na(p) and p > 0
            u := str.substring(u, 0, p)
    u

// 같은 종목의 흔한 이름들을 하나로 (MT5 와 트뷰 이름이 달라도 맞게)
f_family(string s) =>
    u = f_clean(s)
    str.contains(u, "NAS100") or str.contains(u, "US100") or str.contains(u, "USTEC") or str.contains(u, "NDX") or str.startswith(u, "NQ") or str.contains(u, "USTECH") ? "NASDAQ" :
     str.contains(u, "XAU") or str.contains(u, "GOLD") or str.startswith(u, "GC") ? "GOLD" :
     str.contains(u, "USOIL") or str.contains(u, "WTI") or str.contains(u, "XTI") or str.startswith(u, "CL") or str.contains(u, "CRUDE") ? "OIL" :
     str.contains(u, "BTC") or str.contains(u, "XBT") ? "BTC" :
     str.contains(u, "US30") or str.contains(u, "DJ30") or str.contains(u, "DJI") or str.startswith(u, "YM") ? "DOW" :
     str.contains(u, "SPX") or str.contains(u, "US500") or str.contains(u, "SP500") or str.startswith(u, "ES") ? "SP500" : u

f_symMatch(string sym) =>
    string s      = str.upper(sym)
    string mapped = s
    if str.length(symbolAlias) > 0
        for pair in str.split(str.upper(str.replace_all(symbolAlias, " ", "")), ",")
            kv = str.split(pair, "=")
            if array.size(kv) == 2 and (array.get(kv, 0) == s or array.get(kv, 0) == f_clean(s))
                mapped := array.get(kv, 1)
    bool ok = true
    if filterSymbol != ""
        ok := s == str.upper(filterSymbol) or mapped == str.upper(filterSymbol) or f_clean(s) == f_clean(filterSymbol)
    else if autoSymbol
        tk = f_clean(syminfo.ticker)
        m  = f_clean(mapped)
        ok := str.length(m) > 0 and (m == tk or str.startswith(m, tk) or str.startswith(tk, m) or f_family(m) == f_family(tk))
    ok

// 거래 한 건 또는 묶음 하나. 묶음이면 openPrice·closePrice 는 랏 가중 평균, members 는 묶인 개별 거래 번호
type TradeRecord
    int    openTime
    float  openPrice
    int    closeTime
    float  closePrice
    string dir
    float  lot
    float  profit
    string sym
    int    cnt = 1
    int    lastClose = 0
    array<int> members
    float  sl = 0.0          // 청산 직전 SL (없으면 0)
    float  tp = 0.0          // 청산 직전 TP (없으면 0)
    string why = ""          // 청산 이유 한 글자: s=SL t=TP m=직접 a=자동 o=증거금 강제 l=잠금 x=손실 한도
    float  bal = 0.0         // 청산 직전 잔고 (모르면 0) - 손익 % · 증거금율 기준
    float  margin = 0.0      // 이 거래(묶음) 증거금 (모르면 0)
    float  runUp = na        // 들고 있던 동안 최대 평가이익 (이 거래 · 묶음만, MT5 1분봉. 모르면 na)
    float  runDn = na        // 들고 있던 동안 최대 평가손실 (≤ 0)
    float  gUp = na          // 웹이 잰 묶음 값 (묶음 첫 거래 줄에만) - 파인이 묶을 때 이 값을 씀
    float  gDn = na
    bool   hasG = false
    float  pv = 0.0          // 1랏 1포인트 손익 (pt 환산, 모르면 0)
    int    gi = -1           // 개별 거래가 속한 묶음 번호 (개별 거래 보기에서도 묶음 정보를 보여 줄 때)

f_parseRows(string src, int baseMs, string defaultSym, bool isOffset, array<TradeRecord> out) =>
    for row in str.split(src, "\n")
        if str.length(row) > 0 and not str.startswith(row, "H,")
            f = str.split(row, ",")
            minFields = defaultSym != "" ? 7 : 8
            if array.size(f) >= minFields
                sy      = array.size(f) >= 8 ? array.get(f, 7) : defaultSym
                p       = array.get(f, 4)
                posStr  = (p == "b" or p == "buy") ? "buy" : "sell"
                openMs  = isOffset ? baseMs + int(str.tonumber(array.get(f, 0))) * 1000 : int(str.tonumber(array.get(f, 0)))
                closeMs = isOffset ? baseMs + int(str.tonumber(array.get(f, 2))) * 1000 : int(str.tonumber(array.get(f, 2)))
                if f_symMatch(sy)
                    array.push(out, TradeRecord.new(openMs, str.tonumber(array.get(f, 1)), closeMs, str.tonumber(array.get(f, 3)),
                         posStr, str.tonumber(array.get(f, 5)), str.tonumber(array.get(f, 6)), sy, 1, closeMs, array.new<int>()))
    true

// ============================================================
// 1) 파싱 + 묶기: 처음 한 번 (차트를 옮기거나 설정을 바꾸면 지표가 처음부터 다시 계산되므로 그때마다 다시)
//    전역 코드가 너무 길면 파인이 거부해서(CE10295) 전부 함수 안에 둠
// ============================================================
// 덧붙인 SL/TP (진입가 기준 틱 차이, 빈칸이면 없음) → 가격
f_ext(array<string> f, int i, float ticks, float sc) =>
    float v = 0.0
    if array.size(f) > i
        d = str.tonumber(array.get(f, i))
        if not na(d)
            v := (ticks + d) / sc
    v

// 가격 차이(pt) 글자: +12.5pt
f_pt(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x, "#.##") + "pt"

// 묶음 요약 (개별 거래 툴팁에 덧붙임)
f_grpTip(TradeRecord g) =>
    sg = g.dir == "buy" ? 1.0 : -1.0
    pk = g.pv * g.lot
    "\n── 묶음 " + str.tostring(g.cnt) + "건 · " + str.tostring(g.lot) + "랏 (평균가) ──" +
         "\n진입 " + str.tostring(g.openPrice, format.mintick) + " → 청산 " + str.tostring(g.closePrice, format.mintick) +
         "\n손익: " + str.tostring(g.profit, "#.##") +
         (g.bal > 0 ? "  (" + (g.profit >= 0 ? "+" : "") + str.tostring(g.profit / g.bal * 100, "#.##") + "%)" : "") +
         "  " + f_pt((g.closePrice - g.openPrice) * sg) +
         (not na(g.runUp) ? "\n최대 평가이익: +" + str.tostring(g.runUp, "#,###.##") + (pk > 0 ? "  " + f_pt(g.runUp / pk) : "") +
             "\n최대 평가손실: " + str.tostring(g.runDn, "#,###.##") + (g.bal > 0 ? " (" + str.tostring(g.runDn / g.bal * 100, "#.##") + "%)" : "") +
             (pk > 0 ? "  " + f_pt(g.runDn / pk) : "") : "") +
         (g.margin > 0 and g.bal > 0 ? "\n증거금율: " + str.tostring(g.margin / g.bal * 100, "#.#") + "%" : "")

f_whyKr(string w) =>
    w == "s" ? "SL에 걸림" : w == "t" ? "TP에 걸림" : w == "m" ? "직접 청산" : w == "a" ? "자동 청산" :
     w == "o" ? "증거금 강제청산" : w == "l" ? "잠금 강제청산" : w == "x" ? "일일 손실 한도" : ""

// 압축 데이터 한 덩어리 읽기 (st: [앞 줄 진입 ms], lastTicks: 종목별 앞 줄 진입가 틱)
f_parseCompact(string src, array<string> syms, array<float> scales, array<float> mfs, array<float> pvs, array<int> st, array<float> lastTicks, array<float> balSt, array<TradeRecord> out) =>
    for row in str.split(src, "\n")
        f = str.split(row, ",")
        if array.size(f) >= 8
            si      = int(str.tonumber(array.get(f, 7)))
            sc      = array.get(scales, si)
            openMs  = array.get(st, 0) + int(str.tonumber(array.get(f, 0))) * 1000
            array.set(st, 0, openMs)
            closeMs = openMs + int(str.tonumber(array.get(f, 1))) * 1000
            ticks   = array.get(lastTicks, si) + str.tonumber(array.get(f, 2))
            array.set(lastTicks, si, ticks)
            sy      = array.get(syms, si)
            float bal = 0.0                      // 청산 직전 잔고: 앞 줄 잔고 + 차이 (빈칸이면 모름)
            if array.size(f) >= 13
                d = str.tonumber(array.get(f, 12))
                if not na(d)
                    array.set(balSt, 0, array.get(balSt, 0) + d)
                    bal := array.get(balSt, 0)
            if f_symMatch(sy)
                lot = str.tonumber(array.get(f, 5)) / 100
                cnt = array.size(f) >= 12 ? str.tonumber(array.get(f, 11)) : na
                array.push(out, TradeRecord.new(openMs, ticks / sc, closeMs, (ticks + str.tonumber(array.get(f, 3))) / sc,
                     array.get(f, 4) == "b" ? "buy" : "sell", lot, str.tonumber(array.get(f, 6)) / 100,
                     sy, na(cnt) ? 1 : int(cnt), closeMs, array.new<int>(),
                     f_ext(f, 8, ticks, sc), f_ext(f, 9, ticks, sc), array.size(f) >= 11 ? array.get(f, 10) : "",
                     bal, array.get(mfs, si) * lot * ticks / sc,
                     array.size(f) >= 15 ? str.tonumber(array.get(f, 13)) / 100 : na,
                     array.size(f) >= 15 ? str.tonumber(array.get(f, 14)) / 100 : na,
                     array.size(f) >= 17 ? str.tonumber(array.get(f, 15)) / 100 : na,
                     array.size(f) >= 17 ? str.tonumber(array.get(f, 16)) / 100 : na, false, array.get(pvs, si)))
    true

f_load(array<TradeRecord> raw, array<TradeRecord> groups) =>
    syms   = array.new<string>()
    scales = array.new<float>()
    mfs    = array.new<float>()                 // 종목별 증거금 계수 (없으면 0 → 증거금 표시 안 함)
    pvs    = array.new<float>()                 // 종목별 1랏 1포인트 손익 (없으면 0 → 최대 이익 · 손실 pt 표시 안 함)
    if str.length(DATA_SYMS) > 0
        for it in str.split(DATA_SYMS, "|")
            kv = str.split(it, ":")
            array.push(syms, array.get(kv, 0))
            array.push(scales, math.pow(10, array.size(kv) > 1 ? str.tonumber(array.get(kv, 1)) : 2))
            mf = array.size(kv) > 2 ? str.tonumber(array.get(kv, 2)) : na
            array.push(mfs, na(mf) ? 0.0 : mf)
            pv = array.size(kv) > 3 ? str.tonumber(array.get(kv, 3)) : na
            array.push(pvs, na(pv) ? 0.0 : pv)
    st = array.from(DATA_BASE_MS)
    lastTicks = array.new<float>(array.size(syms), 0.0)
    balSt = array.from(0.0)
    for chunk in f_data()
        f_parseCompact(chunk, syms, scales, mfs, pvs, st, lastTicks, balSt, raw)
    if str.length(tradeDataInput) > 0
        cleanInput = str.replace_all(str.replace_all(tradeDataInput, "\r\n", "\n"), "\r", "\n")
        hdr = str.split(array.get(str.split(cleanInput, "\n"), 0), ",")
        if array.size(hdr) >= 2 and array.get(hdr, 0) == "H"
            f_parseRows(cleanInput, int(str.tonumber(array.get(hdr, 1))), array.size(hdr) >= 3 ? array.get(hdr, 2) : "", true, raw)
        else
            f_parseRows(cleanInput, 0, "", false, raw)
    // 묶기: 청산 시각 순으로 보면서 같은 종목·방향의 직전 묶음과 청산이 mergeSec 안이면 합침
    // 개별 거래 보기에서도 툴팁 · 거래 정보 표에 묶음 정보를 보여 주려고 늘 묶어 둠 (그리기는 useGroups 일 때만)
    if not DATA_MERGED and array.size(raw) > 0
        lastOf = map.new<string, int>()
        for i = 0 to array.size(raw) - 1
            r  = array.get(raw, i)
            k  = r.sym + "|" + r.dir
            gi = map.contains(lastOf, k) ? map.get(lastOf, k) : -1
            joinIt = false
            if gi >= 0
                joinIt := r.closeTime - array.get(groups, gi).lastClose <= mergeSec * 1000
            if joinIt
                g = array.get(groups, gi)
                v = g.lot + r.lot
                g.openPrice  := v > 0 ? (g.openPrice * g.lot + r.openPrice * r.lot) / v : g.openPrice
                g.closePrice := v > 0 ? (g.closePrice * g.lot + r.closePrice * r.lot) / v : g.closePrice
                g.lot        := v
                g.profit     := g.profit + r.profit
                g.openTime   := math.min(g.openTime, r.openTime)
                g.closeTime  := math.max(g.closeTime, r.closeTime)
                g.lastClose  := r.closeTime
                g.cnt        := g.cnt + 1
                if g.sl != r.sl                       // 묶음 안 SL/TP 가 서로 다르면 표시 안 함
                    g.sl := 0.0
                if g.tp != r.tp
                    g.tp := 0.0
                if g.why != r.why
                    g.why := ""
                g.margin     := g.margin + r.margin       // 묶음 증거금 = 합계 · 잔고는 첫 청산 직전 것
                if g.bal <= 0
                    g.bal := r.bal
                if not g.hasG and not na(r.runUp)     // 웹이 잰 묶음 값이 없으면 (묶기 간격을 바꾼 경우 등) 개별 값 합으로 어림
                    g.runUp := na(g.runUp) ? r.runUp : g.runUp + r.runUp
                    g.runDn := na(g.runDn) ? r.runDn : g.runDn + r.runDn
                array.push(g.members, i)
                r.gi := gi
            else
                ng = TradeRecord.new(r.openTime, r.openPrice, r.closeTime, r.closePrice, r.dir, r.lot, r.profit, r.sym, 1, r.closeTime, array.from(i), r.sl, r.tp, r.why, r.bal, r.margin,
                     na(r.gUp) ? r.runUp : r.gUp, na(r.gUp) ? r.runDn : r.gDn, na, na, not na(r.gUp), r.pv)
                array.push(groups, ng)
                r.gi := array.size(groups) - 1
                map.put(lastOf, k, array.size(groups) - 1)
    true

// ============================================================
// 2) 그리기: 마지막 봉에서. 자동 페이징이면 화면에 걸친 거래만, 그림 한도가 차면 화면 안에서 최근 것부터
// ============================================================
f_draw(array<TradeRecord> raw, array<TradeRecord> groups) =>
    // 실시간 봉마다 다시 그리므로 앞서 그린 것을 지움
    while array.size(line.all) > 0
        line.delete(array.first(line.all))
    while array.size(label.all) > 0
        label.delete(array.first(label.all))
    while array.size(table.all) > 0
        table.delete(array.first(table.all))

    list    = useGroups ? groups : raw
    n       = array.size(list)
    visL    = chart.left_visible_bar_time
    visR    = chart.right_visible_bar_time
    inView  = 0
    drawn   = 0
    usedLines  = 0
    usedLabels = 0
    full    = false
    winCount = 0
    lossCount = 0
    totalProfit = 0.0
    grossWin = 0.0
    grossLoss = 0.0
    periodKeys   = array.new<string>()
    periodProfit = array.new<float>()
    periodCount  = array.new<int>()
    periodGrow   = array.new<float>()          // 기간 수익률 (거래마다 1 + 손익% 곱)
    grow = 1.0                                 // 수익률 (복리) - 잔고 기록이 있는 거래만
    pctN = 0
    maxMarginPct = 0.0
    worstRunDn = 0.0                           // 거래 중 가장 깊었던 평가손실 % (잔고 대비)
    infoList = array.new<TradeRecord>()        // 거래 정보 표에 넣을 거래 (최근 → 예전)
    infoNums = array.new<int>()                // 그 거래 번호
    sel = f_selSet(infoSel)                    // 고른 번호 (비면 최근 N개)
    selMode = infoOn and array.size(sel) > 0
    infoN = 0                                  // 번호를 매길 거래 수 = 화면 안 거래 수 (고른 번호가 있든 없든 같은 번호 - 왼쪽부터 #1)
    vk = 0                                     // 화면 안 거래 순번 (최근부터 1)
    if infoOn and n > 0
        for i = n - 1 to 0
            t = array.get(list, i)
            if not autoPage or (t.closeTime >= visL and t.openTime <= visR)
                infoN += 1

    if n > 0
        // 청산 시각 순으로 들어 있음 → 뒤(최근)부터 보면서 한도까지 그림
        for i = n - 1 to 0
            t = array.get(list, i)
            visible = not autoPage or (t.closeTime >= visL and t.openTime <= visR)
            if visible
                inView += 1
            if statsScope == "전체" or visible
                if t.profit >= 0
                    winCount += 1
                    grossWin += t.profit
                else
                    lossCount += 1
                    grossLoss += t.profit
                totalProfit += t.profit
                if t.bal > 0
                    grow *= 1 + t.profit / t.bal
                    pctN += 1
                    maxMarginPct := math.max(maxMarginPct, t.margin / t.bal * 100)
                    if not na(t.runDn)
                        worstRunDn := math.min(worstRunDn, t.runDn / t.bal * 100)
                if showAggTable
                    key = f_periodKey(t.closeTime)
                    idx = array.indexof(periodKeys, key)
                    if idx < 0
                        array.push(periodKeys, key)
                        array.push(periodProfit, t.profit)
                        array.push(periodCount, 1)
                        array.push(periodGrow, t.bal > 0 ? 1 + t.profit / t.bal : 1.0)
                    else
                        array.set(periodProfit, idx, array.get(periodProfit, idx) + t.profit)
                        array.set(periodCount, idx, array.get(periodCount, idx) + 1)
                        if t.bal > 0
                            array.set(periodGrow, idx, array.get(periodGrow, idx) * (1 + t.profit / t.bal))
            // 이 거래(묶음)를 그리는 데 드는 선·라벨 수
            picks    = showPicks and useGroups ? array.size(t.members) : 0
            needLab  = 1 + (picks > 0 ? picks : (showEntry ? 1 : 0))
            needLine = (showLines ? 1 : 0) + (showSLTP ? (t.sl > 0 ? 1 : 0) + (t.tp > 0 ? 1 : 0) : 0)
            num = 0                                     // 이 거래 번호 (왼쪽 · 예전부터 #1, 없으면 0)
            if visible
                vk += 1
                num := infoOn and vk <= infoN ? infoN - vk + 1 : 0
            isSel = selMode ? array.includes(sel, num) : num > 0 and vk <= infoCount   // 번호가 없으면 화면 안 최근 N개
            if visible and not full and not (selMode and infoOnly and not isSel)
                if usedLabels + needLab > MAX_LABELS or usedLines + needLine > MAX_LINES
                    full := true
                else
                    drawn += 1
                    usedLabels += needLab
                    usedLines += needLine
                    isWin = t.profit >= 0
                    isBuy = t.dir == "buy"
                    resultCol = isWin ? winColor : lossColor
                    openTimeStr  = str.format_time(t.openTime,  timeFormat, labelTz)
                    closeTimeStr = str.format_time(t.closeTime, timeFormat, labelTz)
                    dirSign = isBuy ? 1.0 : -1.0
                    ptK     = t.pv * t.lot                 // 1pt 움직일 때 이 거래(묶음) 손익
                    tipBase = (num > 0 ? "#" + str.tostring(num) + "  " : "") + t.sym + " " + (isBuy ? "BUY" : "SELL") + (t.cnt > 1 ? "  (" + str.tostring(t.cnt) + "건 묶음, 평균가)" : "") + "\n" +
                         "Open:   " + openTimeStr  + "  @" + str.tostring(t.openPrice, format.mintick) + "\n" +
                         "Close:  " + closeTimeStr + "  @" + str.tostring(t.closePrice, format.mintick) + "\n" +
                         "Lot:    " + str.tostring(t.lot) + "\n" +
                         "Profit: " + str.tostring(t.profit, "#.##") +
                         (t.bal > 0 ? "  (" + (t.profit >= 0 ? "+" : "") + str.tostring(t.profit / t.bal * 100, "#.##") + "%)" : "") +
                         "  " + f_pt((t.closePrice - t.openPrice) * dirSign) +
                         (t.margin > 0 ? "\n증거금: " + str.tostring(t.margin, "#,###.##") +
                             (t.bal > 0 ? "  (잔고의 " + str.tostring(t.margin / t.bal * 100, "#.#") + "%)" : "") : "") +
                         (not na(t.runUp) ? "\n최대 평가이익: +" + str.tostring(t.runUp, "#,###.##") +
                             (t.bal > 0 ? " (+" + str.tostring(t.runUp / t.bal * 100, "#.##") + "%)" : "") +
                             (ptK > 0 ? "  " + f_pt(t.runUp / ptK) : "") +
                             "\n최대 평가손실: " + str.tostring(t.runDn, "#,###.##") +
                             (t.bal > 0 ? " (" + str.tostring(t.runDn / t.bal * 100, "#.##") + "%)" : "") +
                             (ptK > 0 ? "  " + f_pt(t.runDn / ptK) : "") : "") +
                         (t.bal > 0 ? "\n청산 직전 잔고: " + str.tostring(t.bal, "#,###.##") : "") +
                         (t.sl > 0 or t.tp > 0 ? "\nSL " + (t.sl > 0 ? str.tostring(t.sl, format.mintick) + " (" + f_pt((t.sl - t.openPrice) * dirSign) + ")" : "없음") +
                             " · TP " + (t.tp > 0 ? str.tostring(t.tp, format.mintick) + " (" + f_pt((t.tp - t.openPrice) * dirSign) + ")" : "없음") : "") +
                         (t.why != "" ? "\n" + f_whyKr(t.why) : "") +
                         (grpInfo and not useGroups and t.gi >= 0 and t.gi < array.size(groups) ? (array.get(groups, t.gi).cnt > 1 ? f_grpTip(array.get(groups, t.gi)) : "") : "")
                    snappedOpen  = f_snapToBar(t.openTime)
                    snappedClose = f_snapToBar(t.closeTime)
                    if showLines
                        line.new(x1=snappedOpen, y1=t.openPrice, x2=snappedClose, y2=t.closePrice,
                             xloc=xloc.bar_time, color=resultCol, width=lineWidth, style=f_lineStyle())
                    if showSLTP and t.sl > 0          // 청산 직전 SL/TP - 진입부터 청산까지 점선
                        line.new(x1=snappedOpen, y1=t.sl, x2=snappedClose, y2=t.sl, xloc=xloc.bar_time,
                             color=color.new(lossColor, 30), width=1, style=line.style_dotted)
                    if showSLTP and t.tp > 0
                        line.new(x1=snappedOpen, y1=t.tp, x2=snappedClose, y2=t.tp, xloc=xloc.bar_time,
                             color=color.new(winColor, 30), width=1, style=line.style_dotted)
                    if picks > 0
                        // 묶음 + 개별 진입점: 실제로 들어간 자리마다 진입 표시
                        for mi in t.members
                            m = array.get(raw, mi)
                            label.new(x=f_snapToBar(m.openTime), y=m.openPrice, xloc=xloc.bar_time,
                                 text=showTimeLabel ? str.format_time(m.openTime, timeFormat, labelTz) : "", color=entryColor,
                                 style=isBuy ? label.style_triangleup : label.style_triangledown, size=f_labelSize(),
                                 tooltip="OPEN\n" + m.sym + " " + (isBuy ? "BUY" : "SELL") + "\n" +
                                     str.format_time(m.openTime, timeFormat, labelTz) + "  @" + str.tostring(m.openPrice, format.mintick) +
                                     "\nLot: " + str.tostring(m.lot) + "\n묶음 평균 진입가 " + str.tostring(t.openPrice, format.mintick))
                    else if showEntry
                        label.new(x=snappedOpen, y=t.openPrice, xloc=xloc.bar_time,
                             text=showTimeLabel ? openTimeStr : "", color=entryColor,
                             style=isBuy ? label.style_triangleup : label.style_triangledown,
                             size=f_labelSize(), tooltip="OPEN\n" + tipBase)
                    labelY = t.closePrice + t.closePrice * (offsetPct / 100) * (i % 2 == 0 ? 1 : -1)
                    pctText = showPctLabel and t.bal > 0 ? (t.profit >= 0 ? "+" : "") + str.tostring(t.profit / t.bal * 100, "#.##") + "%" : ""
                    profitText0 = (compactMode and not mobileMode) ? "" : str.tostring(t.profit, "#.##")
                    profitText = profitText0 != "" and pctText != "" ? profitText0 + " (" + pctText + ")" : profitText0 + pctText
                    exitTimeText = showTimeLabel ? closeTimeStr : ""
                    exitText0 = profitText != "" and exitTimeText != "" ? exitTimeText + "\n" + profitText : profitText + exitTimeText
                    numText = num > 0 ? "#" + str.tostring(num) : ""   // 화면 안 모든 거래에 번호 (고를 때 보고 넣도록)
                    if isSel
                        array.push(infoList, t)
                        array.push(infoNums, num)
                    exitText = numText != "" ? (exitText0 != "" ? numText + " " + exitText0 : numText) : exitText0
                    label.new(x=snappedClose, y=labelY, xloc=xloc.bar_time,
                         text=exitText, color=resultCol, textcolor=color.white, style=label.style_square,
                         size=f_labelSize(), tooltip="CLOSE\n" + tipBase)

    if showStats
        cnt = winCount + lossCount
        winRate = cnt > 0 ? float(winCount) / cnt * 100 : 0.0
        pf = grossLoss != 0 ? math.abs(grossWin / grossLoss) : na
        unit = useGroups or DATA_MERGED ? "묶음" : "건"
        st = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
        table.cell(st, 0, 0, "보기", text_color=color.white)
        table.cell(st, 1, 0, viewMode + (useGroups ? " · 거래 " + str.tostring(array.size(raw)) + "건" : ""), text_color=color.white)
        table.cell(st, 0, 1, autoPage ? "표시 / 화면 / 전체" : "표시 / 전체", text_color=color.white)
        table.cell(st, 1, 1, (autoPage ? str.tostring(drawn) + " / " + str.tostring(inView) + " / " + str.tostring(n) : str.tostring(drawn) + " / " + str.tostring(n)) + " " + unit,
             text_color=full ? color.orange : color.white)
        table.cell(st, 0, 2, "Win Rate (" + statsScope + ")", text_color=color.white)
        table.cell(st, 1, 2, str.tostring(winRate, "#.#") + "%", text_color=color.white)
        table.cell(st, 0, 3, "Total P/L", text_color=color.white)
        table.cell(st, 1, 3, str.tostring(totalProfit, "#.##"), text_color=totalProfit >= 0 ? winColor : lossColor)
        table.cell(st, 0, 4, "Win / Loss", text_color=color.white)
        table.cell(st, 1, 4, str.tostring(winCount) + " / " + str.tostring(lossCount), text_color=color.white)
        table.cell(st, 0, 5, "Profit Factor", text_color=color.white)
        table.cell(st, 1, 5, na(pf) ? "N/A" : str.tostring(pf, "#.##"), text_color=color.white)
        table.cell(st, 0, 6, "안내", text_color=color.white)
        table.cell(st, 1, 6, full ? "그림 한도(500) - 확대하면 다 보임" : selMode and infoOnly ? "고른 거래만 그림" : "전부 표시", text_color=full ? color.orange : color.white)
        table.cell(st, 0, 7, "수익률 (복리)", text_color=color.white)
        table.cell(st, 1, 7, pctN > 0 ? (grow >= 1 ? "+" : "") + str.tostring((grow - 1) * 100, "#.##") + "%" + (pctN < winCount + lossCount ? " (잔고 기록 " + str.tostring(pctN) + "건)" : "") : "잔고 기록 없음",
             text_color=grow >= 1 ? winColor : lossColor)
        table.cell(st, 0, 8, "최대 증거금율", text_color=color.white)
        table.cell(st, 1, 8, maxMarginPct > 0 ? str.tostring(maxMarginPct, "#.#") + "% (거래 1건 기준)" : "-", text_color=maxMarginPct >= 20 ? color.orange : color.white)
        table.cell(st, 0, 9, "거래 중 최대 평가손실", text_color=color.white)
        table.cell(st, 1, 9, worstRunDn < 0 ? str.tostring(worstRunDn, "#.##") + "% (잔고 대비)" : "-", text_color=worstRunDn <= -20 ? color.orange : color.white)
        table.cell(st, 0, 10, "Data", text_color=color.white)
        table.cell(st, 1, 10, DATA_GENERATED, text_color=color.white)

    if infoOn and array.size(infoList) > 0
        k    = array.size(infoList)
        gcol = grpInfo and not useGroups and array.size(groups) > 0
        cols = 6 + (infoRun ? 2 : 0) + (infoMargin ? 1 : 0) + (infoSLTP ? 2 : 0) + (gcol ? 3 : 0)
        it   = table.new(f_infoPos(), cols, k + 1, bgcolor=color.new(color.black, infoBg), border_width=1, border_color=color.gray)
        hb   = color.new(color.gray, 50)
        sz   = f_infoSize()
        hdr  = array.from("#", "청산", "방향 · 랏", "손익", "%", "pt")
        if infoRun
            array.push(hdr, "최대 이익")
            array.push(hdr, "최대 손실")
        if infoMargin
            array.push(hdr, "증거금율")
        if infoSLTP
            array.push(hdr, "SL")
            array.push(hdr, "TP")
        if gcol
            array.push(hdr, "묶음")
            array.push(hdr, "묶음 손익")
            array.push(hdr, "묶음 최대 손실")
        for c = 0 to cols - 1
            table.cell(it, c, 0, array.get(hdr, c), text_color=color.white, bgcolor=hb, text_size=sz)
        for r = 0 to k - 1
            t   = array.get(infoList, k - 1 - r)   // 위에서부터 예전 → 최근 (#1 부터)
            row = r + 1
            sg  = t.dir == "buy" ? 1.0 : -1.0
            pk  = t.pv * t.lot
            pc  = t.profit >= 0 ? winColor : lossColor
            table.cell(it, 0, row, "#" + str.tostring(array.get(infoNums, k - 1 - r)), text_color=color.white, text_size=sz)
            table.cell(it, 1, row, str.format_time(t.closeTime, timeFormat, labelTz), text_color=color.white, text_size=sz)
            table.cell(it, 2, row, (t.dir == "buy" ? "BUY " : "SELL ") + str.tostring(t.lot) + (t.cnt > 1 ? " (" + str.tostring(t.cnt) + "건)" : ""),
                 text_color=t.dir == "buy" ? winColor : lossColor, text_size=sz)
            table.cell(it, 3, row, (t.profit >= 0 ? "+" : "") + str.tostring(t.profit, "#,###.##"), text_color=pc, text_size=sz)
            table.cell(it, 4, row, t.bal > 0 ? (t.profit >= 0 ? "+" : "") + str.tostring(t.profit / t.bal * 100, "#.##") + "%" : "-", text_color=pc, text_size=sz)
            table.cell(it, 5, row, f_pt((t.closePrice - t.openPrice) * sg), text_color=pc, text_size=sz)
            c = 6
            if infoRun
                table.cell(it, c, row, na(t.runUp) ? "-" : (pk > 0 ? f_pt(t.runUp / pk) : "+" + str.tostring(t.runUp, "#,###.##")) +
                     (t.bal > 0 ? " (+" + str.tostring(t.runUp / t.bal * 100, "#.#") + "%)" : ""), text_color=winColor, text_size=sz)
                table.cell(it, c + 1, row, na(t.runDn) ? "-" : (pk > 0 ? f_pt(t.runDn / pk) : str.tostring(t.runDn, "#,###.##")) +
                     (t.bal > 0 ? " (" + str.tostring(t.runDn / t.bal * 100, "#.#") + "%)" : ""), text_color=lossColor, text_size=sz)
                c += 2
            if infoMargin
                mp = t.bal > 0 and t.margin > 0 ? t.margin / t.bal * 100 : na
                table.cell(it, c, row, na(mp) ? "-" : str.tostring(mp, "#.#") + "%", text_color=not na(mp) and mp >= 20 ? color.orange : color.white, text_size=sz)
                c += 1
            if infoSLTP
                table.cell(it, c, row, t.sl > 0 ? f_pt((t.sl - t.openPrice) * sg) : "없음", text_color=color.white, text_size=sz)
                table.cell(it, c + 1, row, t.tp > 0 ? f_pt((t.tp - t.openPrice) * sg) : "없음", text_color=color.white, text_size=sz)
                c += 2
            if gcol
                hasGrp = t.gi >= 0 and t.gi < array.size(groups) ? array.get(groups, t.gi).cnt > 1 : false
                if hasGrp
                    g  = array.get(groups, t.gi)
                    gk = g.pv * g.lot
                    table.cell(it, c, row, str.tostring(g.cnt) + "건 " + str.tostring(g.lot) + "랏", text_color=color.white, text_size=sz)
                    table.cell(it, c + 1, row, (g.profit >= 0 ? "+" : "") + str.tostring(g.profit, "#,###.##") +
                         (g.bal > 0 ? " (" + (g.profit >= 0 ? "+" : "") + str.tostring(g.profit / g.bal * 100, "#.##") + "%)" : ""),
                         text_color=g.profit >= 0 ? winColor : lossColor, text_size=sz)
                    table.cell(it, c + 2, row, na(g.runDn) ? "-" : (gk > 0 ? f_pt(g.runDn / gk) : str.tostring(g.runDn, "#,###.##")) +
                         (g.bal > 0 ? " (" + str.tostring(g.runDn / g.bal * 100, "#.#") + "%)" : ""), text_color=lossColor, text_size=sz)
                else
                    table.cell(it, c, row, "-", text_color=color.white, text_size=sz)
                    table.cell(it, c + 1, row, "-", text_color=color.white, text_size=sz)
                    table.cell(it, c + 2, row, "-", text_color=color.white, text_size=sz)

    if showAggTable and array.size(periodKeys) > 0
        sortedIdx = array.sort_indices(periodKeys, order.ascending)
        total     = array.size(sortedIdx)
        startPos  = total > maxAggRows ? total - maxAggRows : 0
        ag = table.new(f_aggTablePos(), 3, total - startPos + 1, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
        table.cell(ag, 0, 0, aggPeriod == "Weekly" ? "Week" : "Date", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(ag, 1, 0, useGroups or DATA_MERGED ? "묶음" : "Trades", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(ag, 2, 0, "P/L", text_color=color.white, bgcolor=color.new(color.gray, 50))
        rowIdx = 1
        for p = startPos to total - 1
            idx = array.get(sortedIdx, p)
            pnl = array.get(periodProfit, idx)
            table.cell(ag, 0, rowIdx, array.get(periodKeys, idx), text_color=color.white)
            table.cell(ag, 1, rowIdx, str.tostring(array.get(periodCount, idx)), text_color=color.white)
            gr  = array.get(periodGrow, idx)
            table.cell(ag, 2, rowIdx, str.tostring(pnl, "#.##") + (gr != 1.0 ? "  " + (gr >= 1 ? "+" : "") + str.tostring((gr - 1) * 100, "#.##") + "%" : ""),
                 text_color=pnl >= 0 ? winColor : lossColor)
            rowIdx += 1
    true

var array<TradeRecord> RAW    = array.new<TradeRecord>()
var array<TradeRecord> GROUPS = array.new<TradeRecord>()
if barstate.isfirst
    f_load(RAW, GROUPS)
if barstate.islast
    f_draw(RAW, GROUPS)
