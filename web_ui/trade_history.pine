//@version=6
indicator("TraderOS 거래내역", overlay=true, max_lines_count=500, max_labels_count=500)

// ============================================================
// ▼▼▼ TRADEROS DATA BEGIN — TraderOS가 자동 생성, 직접 수정 금지 ▼▼▼
const int    DATA_BASE_MS   = 0
const string DATA_GENERATED = "-"
const string DATA_SYMS      = ""
const bool   DATA_MERGED    = false
f_data() =>
    array.from("")
// ▲▲▲ TRADEROS DATA END ▲▲▲
// 데이터는 f_data() 함수(들) 안에 - 전역에 두면 '본문이 너무 길다'(CE10295)로 거부됨
// 컴파일 토큰 한도(약 10만)가 있어서 압축 형식: 청산 시각 순, 한 줄 = 거래 하나
//   진입시각차(초, 앞 줄 진입 기준),보유(초),진입가차(틱, 같은 종목 앞 줄 기준),청산-진입(틱),b|s,랏×100,손익×100,종목번호[,묶인 건수]
//   DATA_MERGED = true 면 웹에서 이미 묶은 데이터 (평균 진입·청산가, 합계 랏·손익) - 묶음만 표시
//   DATA_SYMS = "종목:소수자리|종목:소수자리" (종목번호 순)
// 웹 TraderOS → 거래내역 → TV → [TV 코드 복사] 로 이 파일 전체를 새로 만들어 붙여넣으면 됨
// ============================================================

// ============================================================
// Inputs
// ============================================================
// 웹이 만든 데이터의 계좌·기간·건수 (설정 창 맨 위에 보이게. 고를 수 있는 값이 하나라 바뀌지 않음)
dataInfo     = input.string("-", "데이터", options=["-"], group="데이터 정보")
viewMode     = input.string("묶음 + 개별 진입점", "보기 방식",
     options=["개별 거래", "묶음 (평단)", "묶음 + 개별 진입점"],
     tooltip="묶음: 같은 종목·방향으로 잇달아 청산한 분할 진입을 한 줄로 (평균 진입가 → 평균 청산가).\n묶음 + 개별 진입점: 묶음 선 + 실제로 들어간 자리마다 진입 표시")
mergeSec     = input.int(60, "묶기 간격 (초)", minval=1, maxval=3600,
     tooltip="같은 종목·방향의 청산이 직전 청산과 이 안이면 같은 묶음")
autoPage     = input.bool(true, "자동 페이징 (화면에 보이는 거래만 그림)",
     tooltip="차트를 옮기거나 확대·축소하면 그 구간 거래로 다시 그림. 화면 안 거래가 한도보다 많으면 화면 안에서 최근 것부터")
autoSymbol   = input.bool(true, "현재 차트 종목만 자동 표시", tooltip="MT5 심볼과 차트 티커가 같은 종목이면 표시 (꼬리표 무시: NAS100+ = NAS100. 흔한 별칭도 같은 종목: NAS100·US100·USTEC·NQ / XAUUSD·GOLD / USOIL·WTI·XTI / BTCUSD·BTCUSDT)")
symbolAlias  = input.string("", "심볼 별칭 (MT5=트뷰)", tooltip="이름이 다를 때. 예: GOLD=XAUUSD,USTEC=NAS100")
filterSymbol = input.string("", "Symbol Filter (수동 지정, 자동보다 우선)")
tradeDataInput = input.text_area(defval="", title="추가 거래 데이터 (선택, 예전 방식)",
     tooltip="비워두면 코드에 내장된 데이터만 사용. 예전 H 헤더/CSV 포맷도 붙여넣기 가능")

compactMode   = input.bool(true,  "Compact Mode (점/네모 + 마우스오버 툴팁)", group="Display")
mobileMode    = input.bool(false, "모바일 모드 (청산 라벨에 손익 항상 표시)", group="Display")
showTimeLabel = input.bool(false, "라벨에 시간 표시", group="Display")
timeFormat    = input.string("MM-dd HH:mm", "시간 표시 형식", group="Display")
labelTz       = input.string("Asia/Seoul", "라벨 시간대", group="Display")
showLines     = input.bool(true,  "Show Entry-Exit Lines",  group="Display")
showEntry     = input.bool(true,  "Show Entry Markers",     group="Display", tooltip="끄면 거래당 라벨이 1개라 한 화면에 더 많이 그림")
showSLTP      = input.bool(true,  "SL/TP 점선 표시",        group="Display", tooltip="청산 직전에 걸려 있던 SL(빨강)·TP(초록)를 진입~청산 구간에 점선으로. 기록이 있는 거래만 (11월 10일 업데이트 이후)")
showStats     = input.bool(false, "Show Stats Table",       group="Display")
statsScope    = input.string("화면", "통계·집계 기준", options=["화면", "전체"], group="Display")
labelSizeOpt  = input.string("tiny", "Label Size", options=["tiny", "small", "normal", "large"], group="Display")
lineWidth     = input.int(1, "Line Width", minval=1, maxval=5, group="Display")
lineStyleOpt  = input.string("Arrow", "Line Style", options=["Arrow", "Solid", "Dashed", "Dotted"], group="Display")
offsetPct     = input.float(0.1, "Label Offset (%)", minval=0, maxval=3, step=0.05, group="Display")

entryColor = input.color(color.new(color.gray, 0), "Entry Marker Color", group="Colors")
winColor   = input.color(color.new(color.teal, 0), "Exit Win Color",     group="Colors")
lossColor  = input.color(color.new(color.red,  0), "Exit Loss Color",    group="Colors")

showAggTable = input.bool(true, "기간별 집계 표 표시", group="Summary Table")
aggPeriod    = input.string("Daily", "집계 단위", options=["Daily", "Weekly"], group="Summary Table")
maxAggRows   = input.int(10, "최대 표시 행수 (최근 N개)", minval=3, maxval=60, group="Summary Table")
aggTablePos  = input.string("Bottom Right", "집계표 위치", options=["Bottom Right", "Bottom Left", "Bottom Center"], group="Summary Table")
aggTz        = input.string("Asia/Seoul", "집계 기준 시간대", group="Summary Table")

// ============================================================
// 전역
// ============================================================
TF_MS     = timeframe.in_seconds(timeframe.period) * 1000
MAX_LINES  = 500         // 파인 그림 한도 (선)
MAX_LABELS = 500         // 파인 그림 한도 (라벨)
// 묶음 데이터(DATA_MERGED)면 한 줄이 이미 묶음 - 다시 묶지 않음
useGroups  = not DATA_MERGED and viewMode != "개별 거래"
showPicks  = not DATA_MERGED and viewMode == "묶음 + 개별 진입점"

f_labelSize() =>
    switch labelSizeOpt
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.tiny

f_lineStyle() =>
    switch lineStyleOpt
        "Arrow"  => line.style_arrow_right
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_arrow_right

f_aggTablePos() =>
    switch aggTablePos
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_snapToBar(ms) =>
    int(math.floor(ms / TF_MS) * TF_MS)

f_periodKey(closeMs) =>
    if aggPeriod == "Weekly"
        dow      = dayofweek(closeMs, aggTz)
        daysBack = dow == dayofweek.sunday ? 6 : dow - dayofweek.monday
        str.format_time(closeMs - daysBack * 86400000, "yyyy-MM-dd", aggTz)
    else
        str.format_time(closeMs, "yyyy-MM-dd", aggTz)

// 심볼 이름 정리: 대문자 + 브로커 꼬리표 떼기 (NAS100+ → NAS100, XAUUSD.r → XAUUSD, BTCUSD-m → BTCUSD)
f_clean(string s) =>
    u = str.upper(s)
    for c in array.from("+", ".", "-", "_", "#", "!", ":")
        p = str.pos(u, c)
        if not na(p) and p > 0
            u := str.substring(u, 0, p)
    u

// 같은 종목의 흔한 이름들을 하나로 (MT5 와 트뷰 이름이 달라도 맞게)
f_family(string s) =>
    u = f_clean(s)
    str.contains(u, "NAS100") or str.contains(u, "US100") or str.contains(u, "USTEC") or str.contains(u, "NDX") or str.startswith(u, "NQ") or str.contains(u, "USTECH") ? "NASDAQ" :
     str.contains(u, "XAU") or str.contains(u, "GOLD") or str.startswith(u, "GC") ? "GOLD" :
     str.contains(u, "USOIL") or str.contains(u, "WTI") or str.contains(u, "XTI") or str.startswith(u, "CL") or str.contains(u, "CRUDE") ? "OIL" :
     str.contains(u, "BTC") or str.contains(u, "XBT") ? "BTC" :
     str.contains(u, "US30") or str.contains(u, "DJ30") or str.contains(u, "DJI") or str.startswith(u, "YM") ? "DOW" :
     str.contains(u, "SPX") or str.contains(u, "US500") or str.contains(u, "SP500") or str.startswith(u, "ES") ? "SP500" : u

f_symMatch(string sym) =>
    string s      = str.upper(sym)
    string mapped = s
    if str.length(symbolAlias) > 0
        for pair in str.split(str.upper(str.replace_all(symbolAlias, " ", "")), ",")
            kv = str.split(pair, "=")
            if array.size(kv) == 2 and (array.get(kv, 0) == s or array.get(kv, 0) == f_clean(s))
                mapped := array.get(kv, 1)
    bool ok = true
    if filterSymbol != ""
        ok := s == str.upper(filterSymbol) or mapped == str.upper(filterSymbol) or f_clean(s) == f_clean(filterSymbol)
    else if autoSymbol
        tk = f_clean(syminfo.ticker)
        m  = f_clean(mapped)
        ok := str.length(m) > 0 and (m == tk or str.startswith(m, tk) or str.startswith(tk, m) or f_family(m) == f_family(tk))
    ok

// 거래 한 건 또는 묶음 하나. 묶음이면 openPrice·closePrice 는 랏 가중 평균, members 는 묶인 개별 거래 번호
type TradeRecord
    int    openTime
    float  openPrice
    int    closeTime
    float  closePrice
    string dir
    float  lot
    float  profit
    string sym
    int    cnt = 1
    int    lastClose = 0
    array<int> members
    float  sl = 0.0          // 청산 직전 SL (없으면 0)
    float  tp = 0.0          // 청산 직전 TP (없으면 0)
    string why = ""          // 청산 이유 한 글자: s=SL t=TP m=직접 a=자동 o=증거금 강제 l=잠금 x=손실 한도

f_parseRows(string src, int baseMs, string defaultSym, bool isOffset, array<TradeRecord> out) =>
    for row in str.split(src, "\n")
        if str.length(row) > 0 and not str.startswith(row, "H,")
            f = str.split(row, ",")
            minFields = defaultSym != "" ? 7 : 8
            if array.size(f) >= minFields
                sy      = array.size(f) >= 8 ? array.get(f, 7) : defaultSym
                p       = array.get(f, 4)
                posStr  = (p == "b" or p == "buy") ? "buy" : "sell"
                openMs  = isOffset ? baseMs + int(str.tonumber(array.get(f, 0))) * 1000 : int(str.tonumber(array.get(f, 0)))
                closeMs = isOffset ? baseMs + int(str.tonumber(array.get(f, 2))) * 1000 : int(str.tonumber(array.get(f, 2)))
                if f_symMatch(sy)
                    array.push(out, TradeRecord.new(openMs, str.tonumber(array.get(f, 1)), closeMs, str.tonumber(array.get(f, 3)),
                         posStr, str.tonumber(array.get(f, 5)), str.tonumber(array.get(f, 6)), sy, 1, closeMs, array.new<int>()))
    true

// ============================================================
// 1) 파싱 + 묶기: 처음 한 번 (차트를 옮기거나 설정을 바꾸면 지표가 처음부터 다시 계산되므로 그때마다 다시)
//    전역 코드가 너무 길면 파인이 거부해서(CE10295) 전부 함수 안에 둠
// ============================================================
// 덧붙인 SL/TP (진입가 기준 틱 차이, 빈칸이면 없음) → 가격
f_ext(array<string> f, int i, float ticks, float sc) =>
    float v = 0.0
    if array.size(f) > i
        d = str.tonumber(array.get(f, i))
        if not na(d)
            v := (ticks + d) / sc
    v

f_whyKr(string w) =>
    w == "s" ? "SL에 걸림" : w == "t" ? "TP에 걸림" : w == "m" ? "직접 청산" : w == "a" ? "자동 청산" :
     w == "o" ? "증거금 강제청산" : w == "l" ? "잠금 강제청산" : w == "x" ? "일일 손실 한도" : ""

// 압축 데이터 한 덩어리 읽기 (st: [앞 줄 진입 ms], lastTicks: 종목별 앞 줄 진입가 틱)
f_parseCompact(string src, array<string> syms, array<float> scales, array<int> st, array<float> lastTicks, array<TradeRecord> out) =>
    for row in str.split(src, "\n")
        f = str.split(row, ",")
        if array.size(f) >= 8
            si      = int(str.tonumber(array.get(f, 7)))
            sc      = array.get(scales, si)
            openMs  = array.get(st, 0) + int(str.tonumber(array.get(f, 0))) * 1000
            array.set(st, 0, openMs)
            closeMs = openMs + int(str.tonumber(array.get(f, 1))) * 1000
            ticks   = array.get(lastTicks, si) + str.tonumber(array.get(f, 2))
            array.set(lastTicks, si, ticks)
            sy      = array.get(syms, si)
            if f_symMatch(sy)
                array.push(out, TradeRecord.new(openMs, ticks / sc, closeMs, (ticks + str.tonumber(array.get(f, 3))) / sc,
                     array.get(f, 4) == "b" ? "buy" : "sell", str.tonumber(array.get(f, 5)) / 100, str.tonumber(array.get(f, 6)) / 100,
                     sy, array.size(f) >= 12 ? int(str.tonumber(array.get(f, 11))) : 1, closeMs, array.new<int>(),
                     f_ext(f, 8, ticks, sc), f_ext(f, 9, ticks, sc), array.size(f) >= 11 ? array.get(f, 10) : ""))
    true

f_load(array<TradeRecord> raw, array<TradeRecord> groups) =>
    syms   = array.new<string>()
    scales = array.new<float>()
    if str.length(DATA_SYMS) > 0
        for it in str.split(DATA_SYMS, "|")
            kv = str.split(it, ":")
            array.push(syms, array.get(kv, 0))
            array.push(scales, math.pow(10, array.size(kv) > 1 ? str.tonumber(array.get(kv, 1)) : 2))
    st = array.from(DATA_BASE_MS)
    lastTicks = array.new<float>(array.size(syms), 0.0)
    for chunk in f_data()
        f_parseCompact(chunk, syms, scales, st, lastTicks, raw)
    if str.length(tradeDataInput) > 0
        cleanInput = str.replace_all(str.replace_all(tradeDataInput, "\r\n", "\n"), "\r", "\n")
        hdr = str.split(array.get(str.split(cleanInput, "\n"), 0), ",")
        if array.size(hdr) >= 2 and array.get(hdr, 0) == "H"
            f_parseRows(cleanInput, int(str.tonumber(array.get(hdr, 1))), array.size(hdr) >= 3 ? array.get(hdr, 2) : "", true, raw)
        else
            f_parseRows(cleanInput, 0, "", false, raw)
    // 묶기: 청산 시각 순으로 보면서 같은 종목·방향의 직전 묶음과 청산이 mergeSec 안이면 합침
    if useGroups and array.size(raw) > 0
        lastOf = map.new<string, int>()
        for i = 0 to array.size(raw) - 1
            r  = array.get(raw, i)
            k  = r.sym + "|" + r.dir
            gi = map.contains(lastOf, k) ? map.get(lastOf, k) : -1
            joinIt = false
            if gi >= 0
                joinIt := r.closeTime - array.get(groups, gi).lastClose <= mergeSec * 1000
            if joinIt
                g = array.get(groups, gi)
                v = g.lot + r.lot
                g.openPrice  := v > 0 ? (g.openPrice * g.lot + r.openPrice * r.lot) / v : g.openPrice
                g.closePrice := v > 0 ? (g.closePrice * g.lot + r.closePrice * r.lot) / v : g.closePrice
                g.lot        := v
                g.profit     := g.profit + r.profit
                g.openTime   := math.min(g.openTime, r.openTime)
                g.closeTime  := math.max(g.closeTime, r.closeTime)
                g.lastClose  := r.closeTime
                g.cnt        := g.cnt + 1
                if g.sl != r.sl                       // 묶음 안 SL/TP 가 서로 다르면 표시 안 함
                    g.sl := 0.0
                if g.tp != r.tp
                    g.tp := 0.0
                if g.why != r.why
                    g.why := ""
                array.push(g.members, i)
            else
                ng = TradeRecord.new(r.openTime, r.openPrice, r.closeTime, r.closePrice, r.dir, r.lot, r.profit, r.sym, 1, r.closeTime, array.from(i), r.sl, r.tp, r.why)
                array.push(groups, ng)
                map.put(lastOf, k, array.size(groups) - 1)
    true

// ============================================================
// 2) 그리기: 마지막 봉에서. 자동 페이징이면 화면에 걸친 거래만, 그림 한도가 차면 화면 안에서 최근 것부터
// ============================================================
f_draw(array<TradeRecord> raw, array<TradeRecord> groups) =>
    // 실시간 봉마다 다시 그리므로 앞서 그린 것을 지움
    while array.size(line.all) > 0
        line.delete(array.first(line.all))
    while array.size(label.all) > 0
        label.delete(array.first(label.all))
    while array.size(table.all) > 0
        table.delete(array.first(table.all))

    list    = useGroups ? groups : raw
    n       = array.size(list)
    visL    = chart.left_visible_bar_time
    visR    = chart.right_visible_bar_time
    inView  = 0
    drawn   = 0
    usedLines  = 0
    usedLabels = 0
    full    = false
    winCount = 0
    lossCount = 0
    totalProfit = 0.0
    grossWin = 0.0
    grossLoss = 0.0
    periodKeys   = array.new<string>()
    periodProfit = array.new<float>()
    periodCount  = array.new<int>()

    if n > 0
        // 청산 시각 순으로 들어 있음 → 뒤(최근)부터 보면서 한도까지 그림
        for i = n - 1 to 0
            t = array.get(list, i)
            visible = not autoPage or (t.closeTime >= visL and t.openTime <= visR)
            if visible
                inView += 1
            if statsScope == "전체" or visible
                if t.profit >= 0
                    winCount += 1
                    grossWin += t.profit
                else
                    lossCount += 1
                    grossLoss += t.profit
                totalProfit += t.profit
                if showAggTable
                    key = f_periodKey(t.closeTime)
                    idx = array.indexof(periodKeys, key)
                    if idx < 0
                        array.push(periodKeys, key)
                        array.push(periodProfit, t.profit)
                        array.push(periodCount, 1)
                    else
                        array.set(periodProfit, idx, array.get(periodProfit, idx) + t.profit)
                        array.set(periodCount, idx, array.get(periodCount, idx) + 1)
            // 이 거래(묶음)를 그리는 데 드는 선·라벨 수
            picks    = showPicks and useGroups ? array.size(t.members) : 0
            needLab  = 1 + (picks > 0 ? picks : (showEntry ? 1 : 0))
            needLine = (showLines ? 1 : 0) + (showSLTP ? (t.sl > 0 ? 1 : 0) + (t.tp > 0 ? 1 : 0) : 0)
            if visible and not full
                if usedLabels + needLab > MAX_LABELS or usedLines + needLine > MAX_LINES
                    full := true
                else
                    drawn += 1
                    usedLabels += needLab
                    usedLines += needLine
                    isWin = t.profit >= 0
                    isBuy = t.dir == "buy"
                    resultCol = isWin ? winColor : lossColor
                    openTimeStr  = str.format_time(t.openTime,  timeFormat, labelTz)
                    closeTimeStr = str.format_time(t.closeTime, timeFormat, labelTz)
                    tipBase = t.sym + " " + (isBuy ? "BUY" : "SELL") + (t.cnt > 1 ? "  (" + str.tostring(t.cnt) + "건 묶음, 평균가)" : "") + "\n" +
                         "Open:   " + openTimeStr  + "  @" + str.tostring(t.openPrice, format.mintick) + "\n" +
                         "Close:  " + closeTimeStr + "  @" + str.tostring(t.closePrice, format.mintick) + "\n" +
                         "Lot:    " + str.tostring(t.lot) + "\n" +
                         "Profit: " + str.tostring(t.profit, "#.##") +
                         (t.sl > 0 or t.tp > 0 ? "\nSL " + (t.sl > 0 ? str.tostring(t.sl, format.mintick) : "없음") + " · TP " + (t.tp > 0 ? str.tostring(t.tp, format.mintick) : "없음") : "") +
                         (t.why != "" ? "\n" + f_whyKr(t.why) : "")
                    snappedOpen  = f_snapToBar(t.openTime)
                    snappedClose = f_snapToBar(t.closeTime)
                    if showLines
                        line.new(x1=snappedOpen, y1=t.openPrice, x2=snappedClose, y2=t.closePrice,
                             xloc=xloc.bar_time, color=resultCol, width=lineWidth, style=f_lineStyle())
                    if showSLTP and t.sl > 0          // 청산 직전 SL/TP - 진입부터 청산까지 점선
                        line.new(x1=snappedOpen, y1=t.sl, x2=snappedClose, y2=t.sl, xloc=xloc.bar_time,
                             color=color.new(lossColor, 30), width=1, style=line.style_dotted)
                    if showSLTP and t.tp > 0
                        line.new(x1=snappedOpen, y1=t.tp, x2=snappedClose, y2=t.tp, xloc=xloc.bar_time,
                             color=color.new(winColor, 30), width=1, style=line.style_dotted)
                    if picks > 0
                        // 묶음 + 개별 진입점: 실제로 들어간 자리마다 진입 표시
                        for mi in t.members
                            m = array.get(raw, mi)
                            label.new(x=f_snapToBar(m.openTime), y=m.openPrice, xloc=xloc.bar_time,
                                 text=showTimeLabel ? str.format_time(m.openTime, timeFormat, labelTz) : "", color=entryColor,
                                 style=isBuy ? label.style_triangleup : label.style_triangledown, size=f_labelSize(),
                                 tooltip="OPEN\n" + m.sym + " " + (isBuy ? "BUY" : "SELL") + "\n" +
                                     str.format_time(m.openTime, timeFormat, labelTz) + "  @" + str.tostring(m.openPrice, format.mintick) +
                                     "\nLot: " + str.tostring(m.lot) + "\n묶음 평균 진입가 " + str.tostring(t.openPrice, format.mintick))
                    else if showEntry
                        label.new(x=snappedOpen, y=t.openPrice, xloc=xloc.bar_time,
                             text=showTimeLabel ? openTimeStr : "", color=entryColor,
                             style=isBuy ? label.style_triangleup : label.style_triangledown,
                             size=f_labelSize(), tooltip="OPEN\n" + tipBase)
                    labelY = t.closePrice + t.closePrice * (offsetPct / 100) * (i % 2 == 0 ? 1 : -1)
                    profitText = (compactMode and not mobileMode) ? "" : str.tostring(t.profit, "#.##")
                    exitTimeText = showTimeLabel ? closeTimeStr : ""
                    exitText = profitText != "" and exitTimeText != "" ? exitTimeText + "\n" + profitText : profitText + exitTimeText
                    label.new(x=snappedClose, y=labelY, xloc=xloc.bar_time,
                         text=exitText, color=resultCol, textcolor=color.white, style=label.style_square,
                         size=f_labelSize(), tooltip="CLOSE\n" + tipBase)

    if showStats
        cnt = winCount + lossCount
        winRate = cnt > 0 ? float(winCount) / cnt * 100 : 0.0
        pf = grossLoss != 0 ? math.abs(grossWin / grossLoss) : na
        unit = useGroups or DATA_MERGED ? "묶음" : "건"
        st = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
        table.cell(st, 0, 0, "보기", text_color=color.white)
        table.cell(st, 1, 0, viewMode + (useGroups ? " · 거래 " + str.tostring(array.size(raw)) + "건" : ""), text_color=color.white)
        table.cell(st, 0, 1, autoPage ? "표시 / 화면 / 전체" : "표시 / 전체", text_color=color.white)
        table.cell(st, 1, 1, (autoPage ? str.tostring(drawn) + " / " + str.tostring(inView) + " / " + str.tostring(n) : str.tostring(drawn) + " / " + str.tostring(n)) + " " + unit,
             text_color=drawn < inView ? color.orange : color.white)
        table.cell(st, 0, 2, "Win Rate (" + statsScope + ")", text_color=color.white)
        table.cell(st, 1, 2, str.tostring(winRate, "#.#") + "%", text_color=color.white)
        table.cell(st, 0, 3, "Total P/L", text_color=color.white)
        table.cell(st, 1, 3, str.tostring(totalProfit, "#.##"), text_color=totalProfit >= 0 ? winColor : lossColor)
        table.cell(st, 0, 4, "Win / Loss", text_color=color.white)
        table.cell(st, 1, 4, str.tostring(winCount) + " / " + str.tostring(lossCount), text_color=color.white)
        table.cell(st, 0, 5, "Profit Factor", text_color=color.white)
        table.cell(st, 1, 5, na(pf) ? "N/A" : str.tostring(pf, "#.##"), text_color=color.white)
        table.cell(st, 0, 6, "안내", text_color=color.white)
        table.cell(st, 1, 6, drawn < inView ? "그림 한도(500) - 확대하면 다 보임" : "전부 표시", text_color=drawn < inView ? color.orange : color.white)
        table.cell(st, 0, 7, "Data", text_color=color.white)
        table.cell(st, 1, 7, DATA_GENERATED, text_color=color.white)

    if showAggTable and array.size(periodKeys) > 0
        sortedIdx = array.sort_indices(periodKeys, order.ascending)
        total     = array.size(sortedIdx)
        startPos  = total > maxAggRows ? total - maxAggRows : 0
        ag = table.new(f_aggTablePos(), 3, total - startPos + 1, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
        table.cell(ag, 0, 0, aggPeriod == "Weekly" ? "Week" : "Date", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(ag, 1, 0, useGroups or DATA_MERGED ? "묶음" : "Trades", text_color=color.white, bgcolor=color.new(color.gray, 50))
        table.cell(ag, 2, 0, "P/L", text_color=color.white, bgcolor=color.new(color.gray, 50))
        rowIdx = 1
        for p = startPos to total - 1
            idx = array.get(sortedIdx, p)
            pnl = array.get(periodProfit, idx)
            table.cell(ag, 0, rowIdx, array.get(periodKeys, idx), text_color=color.white)
            table.cell(ag, 1, rowIdx, str.tostring(array.get(periodCount, idx)), text_color=color.white)
            table.cell(ag, 2, rowIdx, str.tostring(pnl, "#.##"), text_color=pnl >= 0 ? winColor : lossColor)
            rowIdx += 1
    true

var array<TradeRecord> RAW    = array.new<TradeRecord>()
var array<TradeRecord> GROUPS = array.new<TradeRecord>()
if barstate.isfirst
    f_load(RAW, GROUPS)
if barstate.islast
    f_draw(RAW, GROUPS)
